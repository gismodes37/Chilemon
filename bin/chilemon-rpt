#!/usr/bin/env bash
# ==============================================================================
# ChileMon - Wrapper seguro para comandos rpt de Asterisk
# ==============================================================================
# Acepta solo un conjunto fijo de verbos. Los IDs de nodo se validan como
# dígitos decimales antes de llegar a `asterisk -rx`.
#
# Los verbos destructivos de sistema (poweroff, restart de Asterisk/Apache)
# NO están disponibles aquí a propósito: se ejecutan por SSH con sudo real.
# Cualquier persona con ejecución de código como www-data podría invocar un
# wrapper sudo NOPASSWD, así que este archivo solo expone operaciones de radio
# y de actualización controlada.
#
# EchoLink: los nodos usan prefijo 3 + 6 dígitos (7 en total), todos numéricos.
# ==============================================================================

set -u

CMD="${1:-}"
LOCAL="${2:-}"
REMOTE="${3:-}"

ASTERISK_BIN=/usr/sbin/asterisk

require_node_id() {
    local label="$1"
    local value="$2"

    if [[ ! "$value" =~ ^[0-9]+$ ]]; then
        printf 'Invalid %s node id: digits only\n' "$label" >&2
        exit 1
    fi
}

# Git 2.35+ refuses repositories whose owner differs from the running user.
# The wrapper runs as root via sudo while /opt/chilemon may be owned by the
# deploy user, so register it before any git verb. Idempotent by design.
ensure_safe_directory() {
    if ! git config --global --get-all safe.directory 2>/dev/null \
        | grep -qxF '/opt/chilemon'; then
        git config --global --add safe.directory /opt/chilemon 2>/dev/null || true
    fi
}

case "$CMD" in
    nodes|stats)
        require_node_id 'local' "$LOCAL"
        "$ASTERISK_BIN" -rx "rpt $CMD $LOCAL"
        ;;

    connect)
        # *3 = transceive (ASL normal y EchoLink con prefijo 3xxxxxx)
        require_node_id 'local'  "$LOCAL"
        require_node_id 'remote' "$REMOTE"
        "$ASTERISK_BIN" -rx "rpt fun $LOCAL *3$REMOTE"
        ;;

    disconnect)
        # *1 = desconectar nodo remoto específico
        require_node_id 'local'  "$LOCAL"
        require_node_id 'remote' "$REMOTE"
        "$ASTERISK_BIN" -rx "rpt fun $LOCAL *1$REMOTE"
        ;;

    git-fetch)
        # Obtiene refs remotas desde GitHub (no mergea)
        ensure_safe_directory
        cd /opt/chilemon && git fetch origin 2>&1
        ;;

    git-compare)
        # Compara HEAD local con origin/main
        ensure_safe_directory
        cd /opt/chilemon \
            && echo "LOCAL:$(git rev-parse HEAD)" \
            && echo "REMOTE:$(git rev-parse origin/main)" \
            && echo "SUMMARY:$(git log --oneline HEAD..origin/main 2>/dev/null || echo 'up-to-date')"
        ;;

    git-pull)
        # Stash tracked, limpiar untracked que conflictean, pull y restore.
        # El exit code reportado debe ser el de git pull, no el de toda la
        # cadena (stash pop podria fallar despues de un pull exitoso).
        ensure_safe_directory
        cd /opt/chilemon || exit 1
        git stash push -m "chilemon-auto-stash-$(date +%s)" 2>/dev/null
        git clean -fd 2>/dev/null
        git pull origin main 2>&1
        PULL_RC=$?
        git stash pop 2>/dev/null
        echo "STASHED:$PULL_RC"
        exit "$PULL_RC"
        ;;

    sys-restart-webrtc)
        systemctl restart chilemon-webrtc
        ;;

    sys-reload-apache)
        systemctl reload apache2
        ;;

    *)
        # Sin archivo /tmp predecible: el diagnosticador lo lee por stderr.
        printf 'Comando invalido: %s\n' "$CMD" >&2
        exit 1
        ;;
esac
