@echo off
setlocal enabledelayedexpansion
title ChileMon Companion Installer

rem ---------------------------------------------------------------------------
rem Generated by the ChileMon dashboard. Do not edit.
rem Downloads the companion source from the public repository, installs its
rem Python dependencies, writes the generated config and reuses the repo's
rem own config/autostart/start scripts. Safe to run more than once.
rem ---------------------------------------------------------------------------

set "APPDIR=%USERPROFILE%\.chilemon"
set "SRCDIR=%APPDIR%\src"
set "WORK=%TEMP%\chilemon-install-%RANDOM%"
set "CONFIG_B64=__CHILEMON_CONFIG_B64__"

echo [ChileMon] Companion installer
echo.

rem 1. Python must exist before anything is downloaded or registered.
where python >nul 2>&1
if errorlevel 1 (
    echo [ChileMon] ERROR: Python 3.11+ was not found in PATH.
    echo [ChileMon] Install Python from https://www.python.org/downloads/ and run this again.
    exit /b 1
)

rem 2. Dependencies (same packages used by install\companion\build.bat).
echo [ChileMon] Installing Python dependencies...
python -m pip install --user --disable-pip-version-check numpy sounddevice aiohttp
if errorlevel 1 (
    echo [ChileMon] ERROR: could not install numpy and sounddevice.
    exit /b 1
)

rem 3. Download the pinned companion source from GitHub.
echo [ChileMon] Downloading companion source...
if not exist "%APPDIR%" mkdir "%APPDIR%" >nul 2>&1
if not exist "%WORK%" mkdir "%WORK%" >nul 2>&1
powershell -NoProfile -Command "$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; (New-Object Net.WebClient).DownloadFile('https://github.com/gismodes37/Chilemon/archive/refs/heads/__CHILEMON_REPO_REF__.zip', '%WORK%\chilemon.zip')"
if errorlevel 1 (
    echo [ChileMon] ERROR: download failed. Check your internet connection.
    exit /b 1
)
if not exist "%WORK%\chilemon.zip" (
    echo [ChileMon] ERROR: downloaded archive not found.
    exit /b 1
)

rem 4. Extract.
echo [ChileMon] Extracting...
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; Expand-Archive -LiteralPath '%WORK%\chilemon.zip' -DestinationPath '%WORK%\src' -Force"
if errorlevel 1 (
    echo [ChileMon] ERROR: could not extract the archive.
    exit /b 1
)

set "UNZIPPED="
for /d %%D in ("%WORK%\src\Chilemon-*") do set "UNZIPPED=%%D"
if not defined UNZIPPED (
    echo [ChileMon] ERROR: unexpected archive layout.
    exit /b 1
)
if not exist "%UNZIPPED%\companion\install-autostart.bat" (
    echo [ChileMon] ERROR: companion scripts are missing from the archive.
    exit /b 1
)
if not exist "%UNZIPPED%\app\Services\WebRTCBridge\iax2.py" (
    echo [ChileMon] ERROR: IAX2 transport is missing from the archive.
    exit /b 1
)

rem 5. Install to a stable path: autostart stores absolute paths to these files.
echo [ChileMon] Installing companion source...
if exist "%SRCDIR%" rd /s /q "%SRCDIR%" >nul 2>&1
mkdir "%SRCDIR%" >nul 2>&1
xcopy "%UNZIPPED%\companion" "%SRCDIR%\companion\" /E /I /Q /Y >nul
if errorlevel 1 (
    echo [ChileMon] ERROR: could not copy the companion package.
    exit /b 1
)
mkdir "%SRCDIR%\app\Services\WebRTCBridge" >nul 2>&1
copy /Y "%UNZIPPED%\app\Services\WebRTCBridge\iax2.py" "%SRCDIR%\app\Services\WebRTCBridge\iax2.py" >nul
if errorlevel 1 (
    echo [ChileMon] ERROR: could not copy the IAX2 transport.
    exit /b 1
)
rem Namespace packages work without __init__.py, but keep explicit markers.
if not exist "%SRCDIR%\app\__init__.py" echo. > "%SRCDIR%\app\__init__.py"
if not exist "%SRCDIR%\app\Services\__init__.py" echo. > "%SRCDIR%\app\Services\__init__.py"
if not exist "%SRCDIR%\app\Services\WebRTCBridge\__init__.py" echo. > "%SRCDIR%\app\Services\WebRTCBridge\__init__.py"

rem 6. Write the config to a staging file, then validate and install it with the
rem    tested Python helper. Batch never invents or exposes the IAX2 secret.
echo [ChileMon] Writing configuration...
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%WORK%\config.toml', [Convert]::FromBase64String('%CONFIG_B64%'))"
if errorlevel 1 (
    echo [ChileMon] ERROR: could not decode the generated configuration.
    exit /b 1
)
pushd "%SRCDIR%"
python -m companion.install_config --config "%WORK%\config.toml"
if errorlevel 1 (
    popd
    echo [ChileMon] ERROR: configuration validation failed.
    exit /b 1
)
popd

rem 7. Reuse the repo's idempotent autostart and readiness-checked launcher.
echo [ChileMon] Registering autostart and starting the companion...
call "%SRCDIR%\companion\install-autostart.bat"
if errorlevel 1 (
    echo [ChileMon] ERROR: could not register autostart.
    exit /b 1
)
call "%SRCDIR%\companion\start-companion.bat" --autostart
if errorlevel 1 (
    echo [ChileMon] ERROR: companion did not start. See "%APPDIR%\companion-startup.log".
    exit /b 1
)

rd /s /q "%WORK%" >nul 2>&1

echo.
echo [ChileMon] Companion installed and running on 127.0.0.1:9093.
echo [ChileMon] Back in the dashboard, press Connect and then a node for PTT.
exit /b 0
