@echo off
setlocal enabledelayedexpansion
title ChileMon Companion Uninstaller

rem ---------------------------------------------------------------------------
rem Generated by the ChileMon dashboard. Do not edit.
rem Downloads the pinned companion source, PREVIEWS the exact uninstall plan,
rem and only then removes the per-user companion data from this PC.
rem ---------------------------------------------------------------------------

set "WORK=%TEMP%\chilemon-uninstall-%RANDOM%"

echo [ChileMon] Companion uninstaller
echo.

rem 1. Python is required to run the tested uninstaller.
where python >nul 2>&1
if errorlevel 1 (
    echo [ChileMon] ERROR: Python 3.11+ was not found in PATH.
    exit /b 1
)

rem 2. Download the pinned source. The uninstaller is self-contained: no file
rem    under %USERPROFILE%\.chilemon is needed before it runs.
echo [ChileMon] Downloading companion source...
if not exist "%WORK%" mkdir "%WORK%" >nul 2>&1
powershell -NoProfile -Command "$ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; (New-Object Net.WebClient).DownloadFile('https://github.com/gismodes37/Chilemon/archive/refs/heads/__CHILEMON_REPO_REF__.zip', '%WORK%\chilemon.zip')"
if errorlevel 1 (
    echo [ChileMon] ERROR: download failed. Check your internet connection.
    exit /b 1
)
if not exist "%WORK%\chilemon.zip" (
    echo [ChileMon] ERROR: downloaded archive not found.
    exit /b 1
)

rem 3. Extract.
echo [ChileMon] Extracting...
powershell -NoProfile -Command "$ErrorActionPreference='Stop'; Expand-Archive -LiteralPath '%WORK%\chilemon.zip' -DestinationPath '%WORK%\src' -Force"
if errorlevel 1 (
    echo [ChileMon] ERROR: could not extract the archive.
    exit /b 1
)

set "UNZIPPED="
for /d %%D in ("%WORK%\src\Chilemon-*") do set "UNZIPPED=%%D"
if not defined UNZIPPED (
    echo [ChileMon] ERROR: unexpected archive layout.
    exit /b 1
)
if not exist "%UNZIPPED%\companion\uninstall.py" (
    echo [ChileMon] ERROR: uninstaller is missing from the archive.
    exit /b 1
)

rem 4. Preview: print the exact plan without changing anything.
pushd "%UNZIPPED%"
echo.
echo [ChileMon] Preview of what will be removed:
python -m companion.uninstall --dry-run
if errorlevel 1 (
    popd
    echo [ChileMon] ERROR: could not build the uninstall plan.
    exit /b 1
)

rem 5. Explicit local confirmation. The dashboard never authorizes deletion.
echo.
set /p "ANSWER=Remove the items listed above? [y/N] "
if /i not "%ANSWER%"=="y" (
    popd
    echo [ChileMon] Cancelled: nothing was removed.
    exit /b 0
)

rem 6. Remove. --yes is safe here because this script already asked.
python -m companion.uninstall --yes
set "EXITCODE=%ERRORLEVEL%"
popd

rd /s /q "%WORK%" >nul 2>&1

if not "%EXITCODE%"=="0" (
    echo [ChileMon] ERROR: uninstall did not complete. See the messages above.
    exit /b %EXITCODE%
)
echo.
echo [ChileMon] Companion uninstalled from this PC.
echo [ChileMon] To remove the firewall rule as well, run this file as Administrator.
exit /b 0
