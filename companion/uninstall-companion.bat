@echo off
setlocal enabledelayedexpansion
rem Remove every ChileMon Companion trace from this PC so the next install is
rem identical to a fresh machine: stop the process, remove logon autostart
rem (scheduled task, HKCU Run entry and Startup shortcut), then delete the
rem per-user config and logs. Repository source files are never deleted.

cd /d "%~dp0.."

set "TASK_NAME=ChileMon Companion"
set "LOGDIR=%USERPROFILE%\.chilemon"
set "STARTUP=%APPDATA%\Microsoft\Windows\Start Menu\Programs\Startup\ChileMon Companion.lnk"
set "RUNKEY=HKCU\Software\Microsoft\Windows\CurrentVersion\Run"
set "PORT=9093"

echo [ChileMon] Removing Companion from this PC...

rem 1. Stop the process that owns the companion listener.
set "STOPPED=0"
for /f "tokens=5" %%P in ('netstat -ano ^| findstr ":%PORT%" ^| findstr "LISTENING"') do (
    if not "%%P"=="0" (
        echo [ChileMon] Stopping process PID %%P
        taskkill /PID %%P /F >nul 2>&1
        if not errorlevel 1 set "STOPPED=1"
    )
)
if "%STOPPED%"=="1" echo [ChileMon] Companion process stopped.

rem 2. Remove all three logon mechanisms; each may or may not exist.
schtasks /delete /tn "%TASK_NAME%" /f >nul 2>&1
reg delete "%RUNKEY%" /v "%TASK_NAME%" /f >nul 2>&1
if exist "%STARTUP%" del /f /q "%STARTUP%" >nul 2>&1
echo [ChileMon] Autostart entries removed.

rem 3. Remove per-user configuration and logs.
if exist "%LOGDIR%\config.toml" del /f /q "%LOGDIR%\config.toml" >nul 2>&1
if exist "%LOGDIR%\companion.log" del /f /q "%LOGDIR%\companion.log" >nul 2>&1
if exist "%LOGDIR%\companion-startup.log" del /f /q "%LOGDIR%\companion-startup.log" >nul 2>&1
if exist "%LOGDIR%\companion-install.log" del /f /q "%LOGDIR%\companion-install.log" >nul 2>&1
if exist "%LOGDIR%" rmdir "%LOGDIR%" >nul 2>&1
echo [ChileMon] Companion config and logs removed.

rem 4. Remove generated bytecode only; no tracked source is touched.
if exist "%~dp0__pycache__" rmdir /s /q "%~dp0__pycache__" >nul 2>&1

rem 5. The listener must be gone before we report success.
netstat -ano | findstr ":%PORT%" | findstr "LISTENING" >nul 2>&1
if not errorlevel 1 (
    echo [ChileMon] WARNING: port %PORT% is still in use. Check the process manually.
    exit /b 1
)

echo [ChileMon] Companion fully removed. Run install-companion.bat for a fresh install.
exit /b 0
